{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile document representing candidate, company, or platform admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["candidate", "company", "admin"] },
        "phone": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 10 },
        "cep": { "type": "string", "maxLength": 12 },
        "street": { "type": "string", "maxLength": 200 },
        "addressNumber": { "type": "string", "maxLength": 30 },
        "addressComplement": { "type": "string", "maxLength": 100 },
        "neighborhood": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 100 },
        "experienceLevel": { "type": "string", "enum": ["Primeiro Emprego", "Estágio", "Júnior", "Pleno", "Sênior", ""] },
        "education": { "type": "string", "maxLength": 100 },
        "salaryExpectation": { "type": "string", "maxLength": 50 },
        "about": { "type": "string", "maxLength": 2000 },
        "skills": { "type": "array" },
        "experiences": { "type": "array" },
        "educationHistory": { "type": "array" },
        "certifications": { "type": "array" },
        "languages": { "type": "array" },
        "linkedinUrl": { "type": "string", "maxLength": 255 },
        "profileCompleteness": { "type": "number" },
        "resumeFileName": { "type": "string", "maxLength": 255 },
        "resumeDataUrl": { "type": "string", "maxLength": 600000 },
        "documentType": { "type": "string", "enum": ["CPF", "CNPJ"] },
        "documentNumber": { "type": "string", "maxLength": 30 },
        "normalizedDocument": { "type": "string", "maxLength": 20 },
        "cpf": { "type": "string", "maxLength": 30 },
        "cnpj": { "type": "string", "maxLength": 30 },
        "credits": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "type"]
    },
    "DocumentRegistry": {
      "title": "DocumentRegistry",
      "description": "Uniqueness registry for normalized CPF and CNPJ documents without exposing private user data",
      "type": "object",
      "properties": {
        "docId": { "type": "string", "maxLength": 64 },
        "documentType": { "type": "string", "enum": ["CPF", "CNPJ"] },
        "normalizedDocument": { "type": "string", "maxLength": 20 },
        "uid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["docId", "documentType", "normalizedDocument", "uid"]
    },
    "GeneratedResume": {
      "title": "GeneratedResume",
      "description": "Audit record of professional ATS resume PDFs generated by candidates for 15 credits",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "templateId": { "type": "string", "enum": ["ats_classic", "modern_corporate", "first_job_focus"] },
        "fileName": { "type": "string", "maxLength": 255 },
        "downloadUrl": { "type": "string", "maxLength": 500 },
        "creditsCharged": { "type": "number" },
        "transactionId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "templateId", "fileName", "creditsCharged", "transactionId", "createdAt"]
    },
    "Job": {
      "title": "Job",
      "description": "A job opening published by a verified company in Presidente Prudente region",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 150 },
        "location": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "workModel": { "type": "string", "enum": ["Presencial", "Remoto", "Híbrido"] },
        "contract": { "type": "string", "enum": ["CLT", "PJ", "Estágio", "Temporário", "Jovem Aprendiz"] },
        "experience": { "type": "string", "enum": ["Qualquer Nível", "Primeiro Emprego", "Estágio", "Júnior", "Pleno", "Sênior"] },
        "description": { "type": "string", "maxLength": 5000 },
        "skills": { "type": "array" },
        "salaryRange": { "type": "string", "maxLength": 100 },
        "premium": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "closed", "paused"] },
        "applicantCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["companyId", "companyName", "title", "category", "workModel", "contract", "experience", "description", "status"]
    },
    "Application": {
      "title": "Application",
      "description": "Candidate application to a specific job opening with match scoring and status tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "jobId": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "candidateId": { "type": "string", "maxLength": 128 },
        "candidateName": { "type": "string", "maxLength": 150 },
        "candidateEmail": { "type": "string", "maxLength": 256 },
        "candidatePhone": { "type": "string", "maxLength": 30 },
        "candidateRole": { "type": "string", "maxLength": 100 },
        "candidateExperienceLevel": { "type": "string", "maxLength": 50 },
        "candidateEducation": { "type": "string", "maxLength": 100 },
        "candidateSkills": { "type": "array" },
        "candidateAbout": { "type": "string", "maxLength": 2000 },
        "candidateResumeName": { "type": "string", "maxLength": 255 },
        "candidateResumeDataUrl": { "type": "string", "maxLength": 600000 },
        "jobTitle": { "type": "string", "maxLength": 150 },
        "companyName": { "type": "string", "maxLength": 150 },
        "jobLocation": { "type": "string", "maxLength": 150 },
        "matchScore": { "type": "number" },
        "matchingSkills": { "type": "array" },
        "missingSkills": { "type": "array" },
        "status": { "type": "string", "enum": ["Enviado", "Em Análise", "Entrevista", "Aprovado", "Rejeitado"] },
        "recruiterNotes": { "type": "string", "maxLength": 1000 },
        "appliedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["jobId", "companyId", "candidateId", "status", "matchScore"]
    },
    "Report": {
      "title": "Report",
      "description": "A safety or suspicious job/company report submitted by users for moderation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["job", "company", "user"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetTitle": { "type": "string", "maxLength": 200 },
        "reason": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["reporterId", "targetType", "targetId", "reason", "status"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Admin privileges marker document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "grantedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "CreditOrder": {
      "title": "CreditOrder",
      "description": "Purchase order for credit packages processed via Mercado Pago",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userName": { "type": "string", "maxLength": 150 },
        "packageId": { "type": "string", "maxLength": 64 },
        "packageName": { "type": "string", "maxLength": 100 },
        "credits": { "type": "number" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled", "refunded"] },
        "paymentMethod": { "type": "string", "enum": ["pix", "credit_card"] },
        "mpPreferenceId": { "type": "string", "maxLength": 128 },
        "mpPaymentId": { "type": "string", "maxLength": 128 },
        "processedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "packageId", "credits", "amount", "status"]
    },
    "CreditTransaction": {
      "title": "CreditTransaction",
      "description": "Audit record of credit balance additions and usages",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["purchase", "usage", "refund", "bonus", "admin_adjustment"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "description": { "type": "string", "maxLength": 255 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "balanceAfter", "createdAt"]
    },
    "AuthAccount": {
      "title": "AuthAccount",
      "description": "Hashed email and password credential record for direct cloud authentication across custom domains",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "uid", "email", "passwordHash"]
    },
    "AuthBridgeSession": {
      "title": "AuthBridgeSession",
      "description": "Short-lived OAuth credential relay record for cross-domain Google authentication",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "idToken": { "type": "string", "maxLength": 4096 },
        "accessToken": { "type": "string", "maxLength": 2048 },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" }
      },
      "required": ["sessionId", "uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores candidate and company user profiles. Editable by the owner or admin."
    },
    "/document_registry/{docId}": {
      "schema": "DocumentRegistry",
      "description": "Enforces uniqueness for normalized CPF and CNPJ numbers across accounts."
    },
    "/generated_resumes/{resumeId}": {
      "schema": "GeneratedResume",
      "description": "Records generated professional ATS resumes and credit debits."
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job vacancies posted by companies. Publicly readable if active. Managed by company owner or admin."
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Job applications. Readable by candidate owner and recruiting company. Status updated by company or admin."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Community moderation reports. Created by signed in users, read and resolved by admins."
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Platform administrator privilege registry."
    },
    "/credit_orders/{orderId}": {
      "schema": "CreditOrder",
      "description": "Credit package orders initiated by users and confirmed via Mercado Pago webhook or direct API."
    },
    "/credit_transactions/{txId}": {
      "schema": "CreditTransaction",
      "description": "Immutable audit ledger of credit additions, usages, and refunds."
    },
    "/auth_accounts/{accountId}": {
      "schema": "AuthAccount",
      "description": "Stores hashed credentials for direct email/password login across custom and Netlify domains."
    },
    "/auth_bridge/{sessionId}": {
      "schema": "AuthBridgeSession",
      "description": "Ephemeral OAuth credential relay between authorized Cloud Run domain and custom/Netlify domains."
    }
  }
}
