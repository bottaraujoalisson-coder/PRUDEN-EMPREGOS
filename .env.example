# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MERCADO_PAGO_ACCESS_TOKEN: Token de Acesso de Produção ou Teste do Mercado Pago.
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# Necessário para gerar Pix QR Code real e Checkout Pro real de pacotes de créditos.
MERCADO_PAGO_ACCESS_TOKEN=""

# VITE_MERCADO_PAGO_PUBLIC_KEY: Public Key do Mercado Pago (Opcional, para SDK Frontend)
VITE_MERCADO_PAGO_PUBLIC_KEY=""

# NETLIFY_AUTH_TOKEN & NETLIFY_SITE_ID: Credenciais para deploy automatizado via CLI/API (Nunca exponha no código-fonte)
NETLIFY_SITE_ID="cda64c86-bbd4-47f7-8599-65fa92c2cb35"
NETLIFY_AUTH_TOKEN=""
