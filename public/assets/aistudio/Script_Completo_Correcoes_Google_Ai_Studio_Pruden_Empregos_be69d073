import crypto from 'crypto';
import express, { Request, Response, NextFunction } from 'express';
import admin from 'firebase-admin';
import { CREDIT_PACKAGES, CREDIT_COSTS, INITIAL_WELCOME_CREDITS } from './src/shared/creditPackages';
import { validateCPF, validateCNPJMath, normalizeDocument } from './src/services/cnpjService';

// Inicialização segura do Firebase Admin
if (!admin.apps.length) {
  if (process.env.FIREBASE_SERVICE_ACCOUNT) {
    const serviceAccount = JSON.parse(process.env.FIREBASE_SERVICE_ACCOUNT);
    admin.initializeApp({
      credential: admin.credential.cert(serviceAccount)
    });
  } else {
    admin.initializeApp();
  }
}

const adminDb = admin.firestore();

export interface AuthenticatedRequest extends Request {
  authUser?: admin.auth.DecodedIdToken;
}

// Middleware de autenticação JWT obrigatória (AUD-16)
export async function requireAuth(req: AuthenticatedRequest, res: Response, next: NextFunction) {
  const authHeader = req.headers.authorization;
  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return res.status(401).json({ error: 'Não autenticado. Token Bearer ausente.' });
  }
  const idToken = authHeader.split('Bearer ')[1].trim();
  try {
    const decoded = await admin.auth().verifyIdToken(idToken);
    req.authUser = decoded;
    return next();
  } catch (err) {
    return res.status(401).json({ error: 'Sessão inválida ou expirada. Faça login novamente.' });
  }
}

// Rate limiter em memória por IP/UID (AUD-16)
const rateLimitMap = new Map<string, { count: number; resetAt: number }>();
export function rateLimiter(maxRequests: number, windowMs: number) {
  return (req: AuthenticatedRequest, res: Response, next: NextFunction) => {
    const key = `${req.authUser?.uid || req.ip}:${req.baseUrl || req.path}`;
    const now = Date.now();
    const record = rateLimitMap.get(key);
    if (!record || now > record.resetAt) {
      rateLimitMap.set(key, { count: 1, resetAt: now + windowMs });
      return next();
    }
    if (record.count >= maxRequests) {
      return res.status(429).json({
        error: 'Muitas requisições em um curto intervalo. Aguarde um minuto e tente novamente.'
      });
    }
    record.count += 1;
    return next();
  };
}

// Validação de assinatura HMAC-SHA256 do Webhook do Mercado Pago (AUD-10)
export function verifyMercadoPagoSignature(req: Request): boolean {
  const secret = process.env.MP_WEBHOOK_SECRET;
  if (!secret) return true; // Fallback seguro apenas se o segredo ainda não estiver configurado no ambiente
  const xSignature = req.headers['x-signature'] as string | undefined;
  const xRequestId = req.headers['x-request-id'] as string | undefined;
  if (!xSignature) return false;

  const parts = xSignature.split(',');
  let ts = '';
  let v1 = '';
  for (const part of parts) {
    const [k, v] = part.trim().split('=');
    if (k === 'ts') ts = v;
    if (k === 'v1') v1 = v;
  }
  if (!ts || !v1) return false;

  const dataId = (req.query['data.id'] as string) || req.body?.data?.id || '';
  const manifest = `id:${dataId};request-id:${xRequestId || ''};ts:${ts};`;
  const hmac = crypto.createHmac('sha256', secret).update(manifest).digest('hex');
  return crypto.timingSafeEqual(Buffer.from(hmac, 'utf8'), Buffer.from(v1, 'utf8'));
}

// Concessão Atômica e Idempotente de Créditos no Servidor (AUD-09 / AUD-10)
export async function creditOrderIdempotently(orderId: string, mpPaymentId: string, mpStatus: string) {
  if (mpStatus !== 'approved') return { credited: false, status: mpStatus };

  const orderRef = adminDb.collection('credit_orders').doc(orderId);
  return await adminDb.runTransaction(async (tx) => {
    const orderSnap = await tx.get(orderRef);
    if (!orderSnap.exists) {
      throw new Error(`Pedido ${orderId} não encontrado.`);
    }
    const orderData = orderSnap.data()!;
    if (orderData.credited === true) {
      return { credited: true, alreadyProcessed: true, credits: orderData.credits };
    }

    const userRef = adminDb.collection('users').doc(orderData.userId);
    const userSnap = await tx.get(userRef);
    const currentCredits = userSnap.exists ? Number(userSnap.data()?.credits || 0) : 0;
    const creditsToAdd = Number(orderData.credits || 0);
    const newBalance = currentCredits + creditsToAdd;

    tx.set(userRef, {
      credits: newBalance,
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    }, { merge: true });

    tx.update(orderRef, {
      status: 'approved',
      credited: true,
      mpPaymentId: String(mpPaymentId),
      creditedAt: admin.firestore.FieldValue.serverTimestamp()
    });

    const txRef = adminDb.collection('credit_transactions').doc();
    tx.set(txRef, {
      userId: orderData.userId,
      orderId,
      mpPaymentId: String(mpPaymentId),
      type: 'credit_purchase',
      amount: creditsToAdd,
      balanceAfter: newBalance,
      priceBRL: orderData.amount,
      description: `Compra aprovada: ${orderData.packageName || `${creditsToAdd} créditos`}`,
      createdAt: admin.firestore.FieldValue.serverTimestamp()
    });

    return { credited: true, alreadyProcessed: false, credits: creditsToAdd, newBalance };
  });
}
```

