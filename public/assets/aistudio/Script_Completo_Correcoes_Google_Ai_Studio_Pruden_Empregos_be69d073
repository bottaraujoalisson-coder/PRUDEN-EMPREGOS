### Arquivo: `firestore.rules`
```javascript
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNÇÕES AUXILIARES DE AUTENTICAÇÃO E AUTORIZAÇÃO (ZERO-TRUST)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isVerifiedCompanyUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerifiedCompany == true;
    }

    // Impede que o usuário manipule campos financeiros, de privilégio ou verificação
    function hasNoPrivilegedFieldsOnCreate(data) {
      return (!('role' in data) || data.role in ['candidate', 'company']) &&
             (!('credits' in data) || data.credits == 0) &&
             (!('jobPostingCredits' in data) || data.jobPostingCredits == 0) &&
             (!('plan' in data) || data.plan == 'free') &&
             (!('welcomeCreditsGranted' in data) || data.welcomeCreditsGranted == false) &&
             (!('isVerifiedCompany' in data) || data.isVerifiedCompany == false);
    }

    function doesNotModifyProtectedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'credits',
        'jobPostingCredits',
        'role',
        'plan',
        'planExpiresAt',
        'welcomeCreditsGranted',
        'isVerifiedCompany',
        'cnpjStatus',
        'documentVerified'
      ]);
    }

    function doesNotContainSensitivePII(data) {
      return !data.keys().hasAny([
        'cpf',
        'cnpj',
        'document',
        'fiscalAddress',
        'privatePhone',
        'birthDate',
        'passwordHash',
        'salt'
      ]);
    }

    // =========================================================================
    // BLOQUEIO DEFINITIVO DE COLEÇÕES DE FALLBACK LEGADAS (AUD-01 / AUD-06)
    // =========================================================================
    match /auth_accounts/{docId} {
      allow read, write: if false;
    }

    match /auth_bridge/{docId} {
      allow read, write: if false;
    }

    // =========================================================================
    // ADMINISTRADORES (AUD-05)
    // =========================================================================
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false; // Gerenciado exclusivamente via Admin SDK / Console
    }

    // =========================================================================
    // USUÁRIOS (AUD-02)
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && hasNoPrivilegedFieldsOnCreate(request.resource.data);
      allow update: if isAdmin() || (isOwner(userId) && doesNotModifyProtectedUserFields());
      allow delete: if isAdmin();

      match /creditTransactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Exclusivo via Admin SDK no server.ts
      }
    }

    // =========================================================================
    // PERFIS PÚBLICOS DE VITRINE (AUD-02 / AUD-03 - LGPD)
    // =========================================================================
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) &&
                    doesNotContainSensitivePII(request.resource.data) &&
                    (!('isVerifiedCompany' in request.resource.data) || request.resource.data.isVerifiedCompany == false);
      allow update: if isAdmin() || (
                    isOwner(userId) &&
                    doesNotContainSensitivePII(request.resource.data) &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerifiedCompany', 'role', 'credits'])
                  );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // PERFIS PRIVADOS — DADOS SENSÍVEIS LGPD (AUD-03)
    // Contém: cpf, cnpj, document, fiscalAddress, privatePhone, birthDate
    // =========================================================================
    match /private_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // REGISTRO DE UNICIDADE DE CPF/CNPJ (AUD-05 / AUD-07)
    // =========================================================================
    match /documents/{docId} {
      allow get: if isAuthenticated();
      allow list: if false; // Impede enumeração de CPFs/CNPJs
      allow create: if isAuthenticated() &&
                    !exists(/databases/$(database)/documents/documents/$(docId)) &&
                    request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /document_registry/{docId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow write: if false; // Escrita realizada exclusivamente pelo backend server.ts
    }

    // =========================================================================
    // VAGAS DE EMPREGO (AUD-05)
    // =========================================================================
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAdmin() || (
                    isVerifiedCompanyUser() &&
                    request.resource.data.companyId == request.auth.uid &&
                    (!('isHighlighted' in request.resource.data) || request.resource.data.isHighlighted == false)
                  );
      allow update: if isAdmin() || (
                    isAuthenticated() &&
                    resource.data.companyId == request.auth.uid &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['companyId', 'isHighlighted', 'highlightedUntil'])
                  );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.companyId == request.auth.uid);
    }

    // =========================================================================
    // CANDIDATURAS E MATCH (AUD-05 / AUD-13)
    // =========================================================================
    match /applications/{applicationId} {
      allow get, list: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
                    request.resource.data.candidateId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.employerId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'candidateId', 'jobId', 'matchScore', 'matchBreakdown'
      ]);
      allow delete: if isAdmin();
    }

    // =========================================================================
    // CURRÍCULOS GERADOS POR IA (AUD-05)
    // =========================================================================
    match /generated_resumes/{resumeId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // PEDIDOS E TRANSAÇÕES DE CRÉDITOS (AUD-04 / AUD-09 / AUD-10)
    // =========================================================================
    match /credit_orders/{orderId} {
      allow get, list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Exclusivamente via Firebase Admin SDK no server.ts
    }

    match /credit_transactions/{txId} {
      allow get, list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Exclusivamente via Firebase Admin SDK no server.ts
    }
  }
}
